digraph Circuit {
  rankdir=LR;
  compound=true;
  node [shape=box, style=filled, fillcolor=lightblue];
  subgraph cluster_3 {
    label="FullAdder";
    style=filled;
    fillcolor=lightyellow;
    color=gray;
    g4 [label="HalfAdder"];
    g18 [label="HalfAdder"];
    g35 [label="Or"];
  }
  in_0 [label="in_0", shape=ellipse, fillcolor=lightgreen];
  in_1 [label="in_1", shape=ellipse, fillcolor=lightgreen];
  in_2 [label="in_2", shape=ellipse, fillcolor=lightgreen];
  { rank=source; in_0; in_1; in_2; }
  in_0 -> g4;
  in_1 -> g4;
  g4 -> g18;
  in_2 -> g18;
  g4 -> g35;
  g18 -> g35;
}
